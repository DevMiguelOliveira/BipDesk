<Window x:Class="BipDesk.Tech.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BipDesk.Tech.ViewModels"
        xmlns:models="clr-namespace:BipDesk.Tech.Models"
        Title="BipDesk Enterprise Admin - Central de Suporte Remoto"
        Icon="pack://application:,,,/Resources/icon.ico"
        Height="860" Width="1420"
        MinHeight="680" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBgDark}"
        Foreground="{StaticResource BrushTextPrimary}"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <ContextMenu x:Key="MachineContextMenu">
            <MenuItem Header="⚡ Iniciar Acesso Remoto (Enter)" FontWeight="Bold"
                      Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}"/>
            <Separator/>
            <MenuItem Header="📋 Copiar ID BipDesk"
                      Command="{Binding DataContext.CopyIdCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding RustdeskId}"/>
            <MenuItem Header="🌐 Copiar Endereço IP"
                      Command="{Binding DataContext.CopyIpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding IpAddress}"/>
            <MenuItem Header="📝 Copiar Dados para Chamado"
                      Command="{Binding DataContext.CopySummaryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}"/>
            <MenuItem Header="📶 Testar Latência (Ping)"
                      Command="{Binding DataContext.PingMachineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}"/>
            <MenuItem Header="⭐ Alternar Favorito"
                      Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}"/>
            <Separator/>
            <MenuItem Header="💬 Enviar Mensagem na Tela..."
                      Command="{Binding DataContext.SendMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}"/>
            <MenuItem Header="🖨️ Reiniciar Spooler de Impressão"
                      Command="{Binding DataContext.RestartSpoolerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}"/>
            <MenuItem Header="🧹 Limpar Cache DNS (Flush DNS)"
                      Command="{Binding DataContext.FlushDnsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}"/>
            <MenuItem Header="🔄 Renovar Configuração IP (DHCP)"
                      Command="{Binding DataContext.RenewIpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}"/>
            <MenuItem Header="🔒 Bloquear Sessão do Windows"
                      Command="{Binding DataContext.LockWorkstationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}"/>
            <MenuItem Header="⚙️ Atualizar Políticas GPO (gpupdate)"
                      Command="{Binding DataContext.GpUpdateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}"/>
            <MenuItem Header="🔄 Reiniciar Computador Silenciosamente..."
                      Command="{Binding DataContext.RebootCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}"/>
            <Separator/>
            <MenuItem Header="🗑️ Desvincular e Remover Máquina..." Style="{StaticResource DangerMenuItemStyle}"
                      Command="{Binding DataContext.DeleteMachineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}"/>
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Topbar Navigation & Quick Connect -->
            <RowDefinition Height="60"/>
            <!-- Filter Bar & View Segmented Switcher -->
            <RowDefinition Height="46"/>
            <!-- Toast Notification Banner -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content (Sidebar + Machines + Drawer) -->
            <RowDefinition Height="*"/>
            <!-- Active Sessions Dock (Auto-hides if empty) -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. TOPBAR HEADER (INSPIRADA EM TEAMVIEWER) -->
        <Border Grid.Row="0" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="18,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Brand Title & Cloud Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="BipDesk" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushEmerald}"/>
                        <TextBlock Text=" Admin" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                    </StackPanel>

                    <!-- Cloud Pill -->
                    <Border Background="#0C131F" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Margin="0,0,7,0" Fill="{Binding ConnectionStatusColor}"/>
                            <TextBlock Text="{Binding ConnectionStatus}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushTextSecondary}"/>
                        </StackPanel>
                    </Border>

                    <!-- Auto-Update Pill (Se houver update) -->
                    <Border Background="{StaticResource BrushAmberBg}" BorderBrush="{StaticResource BrushAmber}" BorderThickness="1" CornerRadius="12" Padding="8,3" Margin="0,0,10,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUpdateAvailable}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UpdateVersionText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushAmber}" Margin="0,0,8,0"/>
                            <Button Content="Atualizar" Style="{StaticResource ConnectButtonStyle}" Padding="6,2" FontSize="10" Command="{Binding ApplyUpdateCommand}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Center: BARRA UNIFICADA DE BUSCA E CONEXÃO DIRETA (ESTILO TEAMVIEWER) -->
                <Border Grid.Column="1" HorizontalAlignment="Center" Width="440" Background="#0C1019" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchTextBoxStyle}" Height="30" BorderThickness="0" Background="Transparent"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="30,0,10,0" KeyDown="SearchBox_KeyDown" FontSize="12"/>

                        <TextBlock Text="🔍" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" 
                                   VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False"/>

                        <TextBlock Text="Buscar máquina ou digitar ID (Enter para conectar)..." FontSize="11" Foreground="{StaticResource BrushTextMuted}" 
                                   VerticalAlignment="Center" HorizontalAlignment="Left" Margin="32,0,0,0" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Button Grid.Column="1" Content="⚡ Conectar" Style="{StaticResource ConnectButtonStyle}" Padding="14,4" FontSize="11"
                                Command="{Binding QuickConnectCommand}" ToolTip="Conectar ao ID digitado ou máquina selecionada (Enter)"/>
                    </Grid>
                </Border>

                <!-- Right: Actions & User Profile -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Add Machine / Enroll Token -->
                    <Button Content="+ Novo Host" Style="{StaticResource ConnectButtonStyle}" Padding="10,6" Margin="0,0,8,0" Click="AddMachine_Click" ToolTip="Instalar BipDesk Host em um novo cliente"/>

                    <!-- Manage Technicians (Admin only) -->
                    <Button Content="👥 Equipe" Margin="0,0,8,0" Click="ManageTechnicians_Click" ToolTip="Gerenciar contas de técnicos">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Refresh -->
                    <Button Content="🔄" Style="{StaticResource SecondaryButtonStyle}" Padding="8,6" Margin="0,0,12,0" Command="{Binding RefreshCommand}" ToolTip="Atualizar lista"/>

                    <!-- User Pill -->
                    <Border Background="#0C131F" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="14" Padding="8,3">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border CornerRadius="6" Padding="5,1" Margin="0,0,6,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource BrushBlueBg}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource BrushAmberBg}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding CurrentRoleBadge}" FontSize="9" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource BrushBlue}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushAmber}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <TextBlock Text="{Binding CurrentDisplayName}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <Button Content="Sair" Style="{StaticResource IconButtonStyle}" FontSize="10" Click="Logout_Click" ToolTip="Encerrar sessão"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. FILTER BAR & VIEW TOGGLE -->
        <Border Grid.Row="1" Background="{StaticResource BrushBgDark}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="18,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Filter Tabs -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="Todas as Máquinas" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" 
                            Command="{Binding SetFilterCommand}" CommandParameter="Todas"/>
                    <Button Content="🟢 Disponíveis" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" 
                            Command="{Binding SetFilterCommand}" CommandParameter="Online"/>
                    <Button Content="🟡 Em Atendimento" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" 
                            Command="{Binding SetFilterCommand}" CommandParameter="EmAtendimento"/>
                    <Button Content="⭐ Favoritos" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" 
                            Command="{Binding SetFilterCommand}" CommandParameter="Favoritos"/>
                </StackPanel>

                <!-- View Switcher (Cards vs Table) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="⊞ Cards" Padding="10,4" Margin="2" Cursor="Hand" BorderThickness="0"
                                    Command="{Binding ToggleViewCommand}" CommandParameter="Grid">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGridView}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource BrushSurfaceHover}"/>
                                                <Setter Property="Foreground" Value="{StaticResource BrushEmerald}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="☰ Tabela Densa" Padding="10,4" Margin="2" Cursor="Hand" BorderThickness="0"
                                    Command="{Binding ToggleViewCommand}" CommandParameter="Table">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTableView}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource BrushSurfaceHover}"/>
                                                <Setter Property="Foreground" Value="{StaticResource BrushEmerald}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Metrics Summary -->
                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource BrushTextSecondary}">
                    <Run Text="Total: "/>
                    <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                    <Run Text="  |  Disponíveis: "/>
                    <Run Text="{Binding OnlineCount, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource BrushEmerald}"/>
                    <Run Text="  |  Em Atendimento: "/>
                    <Run Text="{Binding BusyCount, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource BrushAmber}"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- 3. TOAST STATUS NOTIFICATION -->
        <Border Grid.Row="2" Background="{StaticResource BrushEmeraldBg}" BorderBrush="{StaticResource BrushEmerald}" BorderThickness="0,0,0,1" Padding="14,6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasStatusNotification}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="⚡ " FontSize="12" Foreground="{StaticResource BrushEmerald}"/>
                <TextBlock Text="{Binding StatusNotification}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
            </StackPanel>
        </Border>

        <!-- 4. MAIN 3-COLUMN WORKSPACE -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <!-- Sidebar (Empresas / Clientes) -->
                <ColumnDefinition Width="230"/>
                <!-- Central Machines List -->
                <ColumnDefinition Width="*"/>
                <!-- Drawer (Detalhes & Ações) -->
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- BARRA LATERAL: EMPRESAS & CLIENTES -->
            <Border Grid.Column="0" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="EMPRESAS &amp; CLIENTES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" Margin="4,2,0,10"/>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"
                             Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource SidebarGroupItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:CompanyGroup}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="#0C1019" CornerRadius="10" Padding="6,2" Margin="6,0,0,0">
                                        <TextBlock FontSize="10" Foreground="{StaticResource BrushTextSecondary}">
                                            <Run Text="{Binding OnlineMachines}" Foreground="{StaticResource BrushEmerald}" FontWeight="Bold"/>
                                            <Run Text="/"/>
                                            <Run Text="{Binding TotalMachines}"/>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ÁREA CENTRAL: CARDS VIEW (Quando IsGridView == True) -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsGridView}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>

                <ListBox ItemsSource="{Binding FilteredMachines}" SelectedItem="{Binding SelectedMachine}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="6"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Machine}">
                            <!-- MACHINE CARD -->
                            <Border Width="280" Height="200" Background="{StaticResource BrushSurface}" 
                                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" 
                                    CornerRadius="10" Padding="14" MouseDown="Card_MouseDown"
                                    ContextMenu="{StaticResource MachineContextMenu}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource BrushSurfaceHover}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BrushEmerald}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Top: Status Pill + Interactive Favorite Star -->
                                    <Grid Grid.Row="0">
                                        <Border HorizontalAlignment="Left" Background="{Binding StatusBadgeBg}" CornerRadius="10" Padding="8,3">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Margin="0,0,6,0" Fill="{Binding StatusColor}"/>
                                                <TextBlock Text="{Binding StatusShortText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding StatusColor}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Botão Favorito Interativo (☆ / ★) -->
                                        <Button HorizontalAlignment="Right" Style="{StaticResource StarButtonStyle}"
                                                Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" ToolTip="Alternar Favorito">
                                            <TextBlock Text="{Binding FavoriteIcon}" FontSize="15" Foreground="{Binding FavoriteColor}"/>
                                        </Button>
                                    </Grid>

                                    <!-- Middle: Display Info -->
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,6">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" 
                                                   Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                        
                                        <!-- ID Pill com 1-Click Copy -->
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <Border Background="#0C1019" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="ID: " FontSize="10" Foreground="{StaticResource BrushTextSecondary}"/>
                                                    <TextBlock Text="{Binding FormattedRustdeskId}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushEmerald}"/>
                                                </StackPanel>
                                            </Border>
                                            <Button Content="📋" Style="{StaticResource IconButtonStyle}" FontSize="10" Margin="4,0,0,0" ToolTip="Copiar ID"
                                                    Command="{Binding DataContext.CopyIdCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding RustdeskId}"/>
                                        </StackPanel>

                                        <TextBlock Text="{Binding SubtitleText}" FontSize="11" Foreground="{StaticResource BrushBlue}" 
                                                   TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- Bottom: Quick Action Connect -->
                                    <Button Grid.Row="2" Content="⚡ CONECTAR (Enter)" Style="{StaticResource ConnectButtonStyle}"
                                            Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" HorizontalAlignment="Stretch"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>

            <!-- ÁREA CENTRAL: TABELA DENSA VIRTUALIZADA (Para 1.000+ Máquinas) -->
            <Grid Grid.Column="1" Background="{StaticResource BrushBgDark}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTableView}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Cabeçalho da Tabela -->
                <Border Grid.Row="0" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="14,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="★" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="STATUS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBlock Grid.Column="2" Text="ID BIPDESK" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBlock Grid.Column="3" Text="DISPOSITIVO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBlock Grid.Column="4" Text="EMPRESA / GRUPO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBlock Grid.Column="5" Text="USUÁRIO / IP" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBlock Grid.Column="6" Text="ÚLTIMO VISTO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBlock Grid.Column="7" Text="AÇÕES RÁPIDAS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Right" Margin="0,0,12,0"/>
                    </Grid>
                </Border>

                <!-- Linhas Virtualizadas em 60 FPS -->
                <ListBox Grid.Row="1" ItemsSource="{Binding FilteredMachines}" SelectedItem="{Binding SelectedMachine}"
                         Background="Transparent" BorderThickness="0"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         ScrollViewer.IsDeferredScrollingEnabled="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="rowBorder" Background="{TemplateBinding Background}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="14,8"
                                                MouseDown="Row_MouseDown" ContextMenu="{StaticResource MachineContextMenu}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="rowBorder" Property="Background" Value="{StaticResource BrushSurfaceHover}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="rowBorder" Property="Background" Value="{StaticResource BrushEmeraldBg}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Machine}">
                            <Grid MouseDown="Row_MouseDown">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Favorite Star -->
                                <Button Grid.Column="0" Style="{StaticResource StarButtonStyle}" HorizontalAlignment="Center"
                                        Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding FavoriteIcon}" FontSize="13" Foreground="{Binding FavoriteColor}"/>
                                </Button>

                                <!-- Status Badge -->
                                <Border Grid.Column="1" HorizontalAlignment="Left" Background="{Binding StatusBadgeBg}" CornerRadius="10" Padding="8,3">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Margin="0,0,6,0" Fill="{Binding StatusColor}"/>
                                        <TextBlock Text="{Binding StatusShortText}" FontSize="11" Foreground="{Binding StatusColor}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>

                                <!-- RustDesk ID + Copy -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FormattedRustdeskId}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushEmerald}" VerticalAlignment="Center"/>
                                    <Button Content="📋" Style="{StaticResource IconButtonStyle}" FontSize="9" Margin="4,0,0,0"
                                            Command="{Binding DataContext.CopyIdCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding RustdeskId}" ToolTip="Copiar ID"/>
                                </StackPanel>

                                <!-- Apelido / Hostname -->
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Hostname}" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Empresa / Grupo -->
                                <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding ClientGroup}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Usuário / IP -->
                                <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding LoggedInUser, TargetNullValue='Sem usuário'}" FontSize="11" Foreground="{StaticResource BrushBlue}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding IpAddress, TargetNullValue='IP N/D'}" FontSize="10" Foreground="{StaticResource BrushTextSecondary}"/>
                                </StackPanel>

                                <!-- Último Visto -->
                                <TextBlock Grid.Column="6" Text="{Binding FormattedLastSeen}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>

                                <!-- Ações Rápidas Inline -->
                                <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="💬" ToolTip="Enviar Mensagem na Tela" Style="{StaticResource InfoButtonStyle}" Margin="0,0,5,0"
                                            Command="{Binding DataContext.SendMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="🔄" ToolTip="Reiniciar Computador" Style="{StaticResource WarningButtonStyle}" Margin="0,0,5,0"
                                            Command="{Binding DataContext.RebootCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="⚡ Conectar" Style="{StaticResource ConnectButtonStyle}" Padding="10,4" FontSize="11"
                                            Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- DRAWER LATERAL DIREITO (PAINEL DO TÉCNICO, DETALHES E NOTAS) -->
            <Border Grid.Column="2" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1,0,0,0" Padding="18">
                <Grid>
                    <!-- EMPTY STATE: QUANDO NENHUMA MÁQUINA ESTÁ SELECIONADA -->
                    <Border VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedMachine}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🖥️" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,12" Opacity="0.6"/>
                            <TextBlock Text="Nenhum Dispositivo Selecionado" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Selecione um computador da lista para acessar controle remoto, notas técnicas e comandos rápidos." 
                                       FontSize="11" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- SELECTED MACHINE DETAILS -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedMachine}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <StackPanel DataContext="{Binding SelectedMachine}">
                            <!-- Header: Title, Status Badge, Star & Delete -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="PAINEL DO DISPOSITIVO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}"/>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <Border Background="#0C1019" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding FormattedRustdeskId, StringFormat='ID: {0}'}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushEmerald}"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <!-- Star Toggle -->
                                    <Button Style="{StaticResource StarButtonStyle}" Margin="0,0,6,0"
                                            Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" ToolTip="Alternar Favorito">
                                        <TextBlock Text="{Binding FavoriteIcon}" FontSize="16" Foreground="{Binding FavoriteColor}"/>
                                    </Button>

                                    <!-- Delete Machine -->
                                    <Button Content="🗑️" Style="{StaticResource WarningButtonStyle}" Padding="6,4" FontSize="10" ToolTip="Remover Máquina"
                                            Command="{Binding DataContext.DeleteMachineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Status Pill -->
                            <Border HorizontalAlignment="Left" Background="{Binding StatusBadgeBg}" CornerRadius="10" Padding="10,3" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Margin="0,0,6,0" Fill="{Binding StatusColor}"/>
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{Binding StatusColor}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>

                            <!-- Concurrency Alert (Se outro técnico estiver conectado) -->
                            <Border Background="{StaticResource BrushAmberBg}" BorderBrush="{StaticResource BrushAmber}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,14">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="⚠️ EM ATENDIMENTO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushAmber}"/>
                                    <TextBlock FontSize="11" Foreground="{StaticResource BrushTextPrimary}" Margin="0,2,0,0">
                                        <Run Text="Conectado por: "/>
                                        <Run Text="{Binding BusyBy}" FontWeight="Bold"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Botão Principal Conectar -->
                            <Button Content="⚡ INICIAR ACESSO REMOTO (Enter)" Style="{StaticResource ConnectButtonStyle}" Padding="14,10" Margin="0,0,0,14"
                                    Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>

                            <!-- Ações Remotas e Diagnóstico -->
                            <TextBlock Text="COMANDOS RÁPIDOS HELPDESK" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,6"/>
                            <UniformGrid Columns="3" Margin="0,0,0,6">
                                <Button Content="💬 Mensagem" Style="{StaticResource InfoButtonStyle}" Margin="0,0,2,3" ToolTip="Exibir aviso na tela do usuário"
                                        Command="{Binding DataContext.SendMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="🖨️ Spooler" Style="{StaticResource InfoButtonStyle}" Margin="2,0,2,3" ToolTip="Reiniciar serviço de impressão"
                                        Command="{Binding DataContext.RestartSpoolerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="🧹 Flush DNS" Style="{StaticResource InfoButtonStyle}" Margin="2,0,0,3" ToolTip="Limpar cache DNS da máquina"
                                        Command="{Binding DataContext.FlushDnsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="🌐 Renovar IP" Style="{StaticResource InfoButtonStyle}" Margin="0,3,2,0" ToolTip="Renovar concessão DHCP (ipconfig /renew)"
                                        Command="{Binding DataContext.RenewIpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="🔒 Bloquear" Style="{StaticResource InfoButtonStyle}" Margin="2,3,2,0" ToolTip="Bloquear sessão do Windows"
                                        Command="{Binding DataContext.LockWorkstationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="🔄 Reiniciar" Style="{StaticResource WarningButtonStyle}" Margin="2,3,0,0" ToolTip="Reiniciar computador"
                                        Command="{Binding DataContext.RebootCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </UniformGrid>

                            <!-- Ações Rápidas de Atendimento -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="📋 Dados p/ Chamado" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,3,0" ToolTip="Copiar resumo completo para colar em ticket"
                                        Command="{Binding DataContext.CopySummaryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                                <Button Grid.Column="1" Content="📶 Testar Ping" Style="{StaticResource SecondaryButtonStyle}" Margin="3,0,0,0" ToolTip="Testar conectividade e tempo de resposta"
                                        Command="{Binding DataContext.PingMachineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>

                            <Separator Background="{StaticResource BrushBorder}" Margin="0,0,0,12"/>

                            <!-- Dados do Dispositivo com 1-Click Copy -->
                            <TextBlock Text="DADOS DO DISPOSITIVO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,8"/>
                            
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="ID BipDesk:" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding FormattedRustdeskId}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource BrushEmerald}" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Button Content="📋" Style="{StaticResource IconButtonStyle}" FontSize="9" Margin="4,0,0,0" ToolTip="Copiar ID"
                                            Command="{Binding DataContext.CopyIdCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding RustdeskId}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Endereço IP:" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding IpAddress, TargetNullValue='N/D'}" FontSize="11" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                    <Button Content="📋" Style="{StaticResource IconButtonStyle}" FontSize="9" Margin="4,0,0,0" ToolTip="Copiar IP"
                                            Command="{Binding DataContext.CopyIpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding IpAddress}"/>
                                    <Button Content="📶" Style="{StaticResource IconButtonStyle}" FontSize="9" Margin="2,0,0,0" ToolTip="Testar Ping"
                                            Command="{Binding DataContext.PingMachineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Usuário Ativo:" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                                <TextBlock Text="{Binding LoggedInUser, TargetNullValue='Sem usuário'}" FontSize="11" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Sistema Operacional:" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                                <TextBlock Text="{Binding OsVersion, TargetNullValue='Windows'}" FontSize="11" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Right"/>
                            </Grid>

                            <Separator Background="{StaticResource BrushBorder}" Margin="0,0,0,12"/>

                            <!-- Organização & Metadados -->
                            <TextBlock Text="ORGANIZAÇÃO &amp; GRUPO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,6"/>

                            <TextBlock Text="Empresa / Cliente" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding ClientGroup, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchTextBoxStyle}" Height="34" Margin="0,0,0,8"/>

                            <TextBlock Text="Apelido da Máquina" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding Alias, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchTextBoxStyle}" Height="34" Margin="0,0,0,10"/>

                            <Button Content="💾 Salvar Alterações" Style="{StaticResource SecondaryButtonStyle}" 
                                    Command="{Binding DataContext.SaveMachineInfoCommand, RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Right" Margin="0,0,0,14"/>

                            <!-- Botão Destacado de Desvincular e Remover Máquina -->
                            <Separator Background="{StaticResource BrushBorder}" Margin="0,8,0,12"/>
                            <Button Content="🗑️ Desvincular e Remover Dispositivo do Painel" Style="{StaticResource WarningButtonStyle}"
                                    HorizontalAlignment="Stretch" Padding="10,8" Margin="0,0,0,16" ToolTip="Remove o dispositivo da nuvem do BipDesk"
                                    Command="{Binding DataContext.DeleteMachineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 5. SESSÕES ATIVAS DOCK (AUTO-HIDE QUANDO ZERO SESSÕES) -->
        <Border Grid.Row="4" Background="#080B10" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="16,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActiveSessions.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Sessões Remotas Abertas:" FontSize="11" FontWeight="SemiBold" 
                           Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                <ItemsControl Grid.Column="1" ItemsSource="{Binding ActiveSessions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:ActiveSession}">
                            <!-- SESSION CHIP -->
                            <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushEmerald}" 
                                    BorderThickness="1" CornerRadius="12" Padding="8,3" Margin="0,0,8,0" Cursor="Hand">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource BrushEmerald}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Machine.DisplayName}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,8,0"/>
                                    <Button Content="✕" FontSize="10" Foreground="{StaticResource BrushRed}" Background="Transparent" BorderThickness="0" 
                                            Command="{Binding DataContext.CloseSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" Cursor="Hand"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</Window>
