<Window x:Class="BipDesk.Tech.Views.TechniciansDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestão da Equipe de Técnicos - BipDesk Enterprise"
        Icon="pack://application:,,,/Resources/icon.ico"
        Height="580" Width="820"
        MinHeight="500" MinWidth="750"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBgDark}"
        Foreground="{StaticResource BrushTextPrimary}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Content -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="👥 Gestão da Equipe de Técnicos" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushEmerald}"/>
                    <Border Margin="12,0,0,0" Background="#1D2433" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="10,3">
                        <TextBlock Text="Área Restrita do Administrador" FontSize="11" Foreground="{StaticResource BrushAmber}" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Cadastre novos técnicos e gerencie quem possui acesso ao BipDesk Admin." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>

            <Button Grid.Column="1" Content="🔄 Recarregar" Style="{StaticResource SecondaryButtonStyle}" Click="BtnRefresh_Click"/>
        </Grid>

        <!-- MAIN SPLIT CONTENT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Technicians List (Left) -->
                <ColumnDefinition Width="*"/>
                <!-- New Technician Form (Right) -->
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: TECHNICIANS LIST -->
            <Border Grid.Column="0" Margin="0,0,16,0" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Técnicos &amp; Administradores Cadastrados" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                        <TextBlock x:Name="TxtTotalCount" Text=" (0)" FontSize="13" Foreground="{StaticResource BrushTextSecondary}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ItemsTechnicians">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#10141D" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Avatar Circle -->
                                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" Background="#1A2333" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="👤" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FullName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                    <!-- Role Pill -->
                                                    <Border Margin="8,0,0,0" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#1D2A44"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Role}" Value="admin">
                                                                        <Setter Property="Background" Value="#332711"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding RoleBadge}" FontSize="10" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource BrushBlue}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Role}" Value="admin">
                                                                            <Setter Property="Foreground" Value="{StaticResource BrushAmber}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Username, StringFormat='@{0}'}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Action Button -->
                                            <Button Grid.Column="2" Content="🗑️ Excluir" Style="{StaticResource WarningButtonStyle}" Padding="8,4" FontSize="11" VerticalAlignment="Center" Click="BtnDeleteTechnician_Click" Tag="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- RIGHT: NEW TECHNICIAN FORM -->
            <Border Grid.Column="1" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="18">
                <StackPanel>
                    <TextBlock Text="Cadastrar Novo Técnico" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushEmerald}" Margin="0,0,0,4"/>
                    <TextBlock Text="Crie um login individual para cada membro da sua equipe de TI." FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,16" TextWrapping="Wrap"/>

                    <!-- Nome Completo -->
                    <TextBlock Text="Nome Completo" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtNewFullName" Style="{StaticResource SearchTextBoxStyle}" Margin="0,0,0,12"/>

                    <!-- Nome de Usuário -->
                    <TextBlock Text="Nome de Usuário (Login)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtNewUsername" Style="{StaticResource SearchTextBoxStyle}" Margin="0,0,0,12"/>

                    <!-- Senha -->
                    <TextBlock Text="Senha de Acesso" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtNewPassword" Style="{StaticResource SearchTextBoxStyle}" Margin="0,0,0,12"/>

                    <!-- Cargo / Permissão -->
                    <TextBlock Text="Nível de Acesso (Cargo)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CbNewRole" Height="34" Margin="0,0,0,16" SelectedIndex="0">
                        <ComboBoxItem Content="Técnico de Suporte (Padrão)"/>
                        <ComboBoxItem Content="Administrador (Acesso Total)"/>
                    </ComboBox>

                    <!-- Mensagem de Feedback -->
                    <TextBlock x:Name="TxtFormStatus" Text="" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap" Visibility="Collapsed" HorizontalAlignment="Center"/>

                    <!-- Botão de Criação -->
                    <Button x:Name="BtnCreateTechnician" Content="+ Criar Conta de Acesso" Style="{StaticResource ConnectButtonStyle}" Height="38" FontSize="13" Click="BtnCreateTechnician_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
