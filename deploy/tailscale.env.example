# ========================================================
# Configurações do BipDesk Tailscale Mesh (ADR-003)
# ========================================================

# 1. Chave de Autenticação Tailscale (Gere em https://login.tailscale.com/admin/settings/keys)
# Recomenda-se criar uma chave do tipo 'Reusable' com tag 'tag:server'
TS_AUTHKEY=tskey-auth-kXXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# 2. Hostname do servidor dentro da sua rede Tailscale
TS_HOSTNAME=bipdesk-server

# 3. Domínio MagicDNS completo ou IP Tailscale (100.x.y.z)
# Exemplo: bipdesk-server.sua-tailnet.ts.net
DOMAIN=bipdesk-server

# 4. Segredos do BipDesk (Conforme .env.example)
SECRET_KEY=gere_uma_chave_aleatoria_com_pelo_menos_32_caracteres_aqui
ADMIN_PASSWORD=DefinaUmaSenhaSeguraAqui123!
FERNET_KEYS=GereUmaChaveFernetCom_python_c_from_cryptography_fernet_import_Fernet_print_Fernet_generate_key_decode
