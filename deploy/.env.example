# =====================================================================
# BipDesk Enterprise - Environment Configuration Template
# =====================================================================
# INSTRUÇÕES:
# 1. Copie este arquivo para .env (ou deploy/.env)
# 2. Preencha valores de alta entropia para os segredos obrigatórios
# 3. NUNCA envie o arquivo .env preenchido para o controle de versão (git)
# =====================================================================

# Modo de Execução: 'production' ou 'development'
ENV=production

# Chave secreta obrigatória para assinatura de tokens JWT (HS256)
# Gerar com: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Chaves Fernet (separadas por vírgula para suporte à rotação MultiFernet)
# Gerar com: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEYS=

# Diretório para armazenamento seguro de chaves persistentes em volume Docker
SECRETS_DIR=/data/secrets

# Senha inicial para o usuário 'admin' (obrigatória na primeira inicialização)
ADMIN_PASSWORD=

# Banco de Dados SQLite corporativo com suporte a concorrência WAL
DATABASE_URL=sqlite:////data/bipdesk.db

# Configurações de escuta da API (interna à rede Docker ou interface local)
HOST=0.0.0.0
PORT=8080

# Chave pública do servidor de sinalização (HBBS) gerada em volume
SERVER_PUBKEY_PATH=/server-keys/id_ed25519.pub

# Domínio ou IP do Host na rede Mesh/Privada (Tailscale/Headscale ou FQDN)
DOMAIN=bipdesk.internal